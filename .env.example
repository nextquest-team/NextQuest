# =============================================================================
# NextQuest — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs manquantes
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# En local sans Docker : localhost
# En Docker : les valeurs sont surchargées automatiquement par docker-compose
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://nextquest:nextquest@localhost:5432/nextquest

# -----------------------------------------------------------------------------
# Redis
# En local sans Docker : localhost
# En Docker : surcharge automatique par docker-compose
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT — changer obligatoirement en production
# Générer avec : openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# -----------------------------------------------------------------------------
# Chiffrement des tokens OAuth gaming (AES-256-GCM)
# Générer avec : openssl rand -hex 32
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=dev-encryption-key-change-in-production

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# URL interne de l'API (service-to-service). En Docker : http://api:3000
API_BASE_URL=http://localhost:3000
# URL publique de l'API utilisée pour le redirect_uri OAuth.
# Doit être joignable par le browser de l'utilisateur.
# En local et en Docker dev : http://localhost:3000
# En production : URL publique du domaine (ex: https://api.nextquest.io)
OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OAuth Google — console.cloud.google.com > API & Services > Credentials
# URI de redirection autorisée : http://localhost:3000/api/auth/oauth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OAuth Microsoft — portal.azure.com > App registrations
# URI de redirection autorisée : http://localhost:3000/api/auth/oauth/microsoft/callback
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Frontend — URL vers laquelle l'API redirige après OAuth
# En local : http://localhost:3001
# En production : URL publique du frontend
# -----------------------------------------------------------------------------
OAUTH_REDIRECT_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Web (Nuxt) — optionnel en local, requis si le web tourne hors Docker
# En Docker : surcharge automatique par docker-compose (http://api:3000)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=http://localhost:3000
