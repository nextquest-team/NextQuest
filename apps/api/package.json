{
  "name": "@nextquest/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate:openapi": "tsx scripts/export-openapi.ts",
    "refresh:releases": "tsx src/scripts/refresh-releases.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@nextquest/db": "workspace:*",
    "@nextquest/shared": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.11.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nextquest/config": "workspace:*",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
